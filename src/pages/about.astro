---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const stack = [
  'Flutter', 'Swift', 'React Native', 'React', 'Rust', 'Python', 'Node.js', 'Go',
];

const highlights = [
  { name: 'Meno', tag: 'Spiritual app' },
  { name: 'Victus', tag: 'Habit tracker' },
  { name: 'Blockroll', tag: 'Fintech' },
  { name: 'AfroHalalPair', tag: 'Cross-platform' },
];
---

<Layout title="About — Gordian Okon">
  <Nav />
  <section id="about" class="mx-auto max-w-3xl px-4 py-16 lg:px-6">
    <span class="eyebrow">Personnel file</span>
    <h1 class="mt-2 font-display text-4xl font-bold">About me</h1>

    <div class="mt-6 space-y-5 text-paper-300">
      <p>
        I'm Gordian Okon, but the world knows me as Guardianprime — a
        developer with an obsession for building things that work
        beautifully and make a real impact.
      </p>
      <p>
        My journey started with curiosity and a laptop. Today, I've built
        and shipped 20+ apps on the App Store and Play Store used by people
        across the globe, built a programming language from scratch with
        Rust, and contributed to the open-source ecosystem with projects
        like Dart ML.
      </p>
      <p>
        I don't just code — I architect experiences. From spiritual apps
        like Meno to habit trackers like Victus, from fintech platforms
        like Blockroll to cross-platform solutions like AfroHalalPair, I
        bring ideas to life with precision and passion. When I'm not
        shipping code, I'm writing about tech on Medium and Dev.to, sharing
        insights with the global developer community.
      </p>
    </div>

    <div class="stub-divider mt-10"></div>

    <h2 class="eyebrow mt-10">Stack</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      {
        stack.map((tool) => (
          <span class="rounded-full border border-ink-600 bg-ink-900 px-3 py-1 text-sm text-paper-100">
            {tool}
          </span>
        ))
      }
    </div>

    <h2 class="eyebrow mt-10">Selected work</h2>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {
        highlights.map((item) => (
          <div class="rounded-xl border border-ink-600 bg-ink-900 p-4">
            <p class="font-display font-semibold">{item.name}</p>
            <p class="text-sm text-paper-500">{item.tag}</p>
          </div>
        ))
      }
    </div>
  </section>
  <Footer />
</Layout>
