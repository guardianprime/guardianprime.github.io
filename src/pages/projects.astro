---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Project from '../components/Projects.astro';

const experience = [
  {
    role: 'Backend AI Engineering Intern',
    org: 'Flyrank AI',
    period: '2026 — present',
    points: [
      'Build RESTful Node.js endpoints for AI responses',
      'Set up RAG retrieval pipelines with vector data stores',
      'Integrate external LLM APIs (OpenAI, Claude) into product workflows',
      'Handle PostgreSQL / MongoDB / SQLite database operations',
    ],
  },
  {
    role: 'Backend Engineer',
    org: 'Trackly',
    period: '2025 - 2026',
    points: [
      'Designed and implemented scalable financial taxonomy systems connecting Transactions, Categories, and Groups',
      'Built secure CRUD APIs and protected category logic for financial workflows',
      'Developed an automated transaction rules engine based on merchant names, amounts, and keywords',
      'Designed flexible transaction tagging using many-to-many database relationships',
      'Built real-time budget aggregation services for spending analysis and reporting',
      'Implemented transaction sync pipelines between the Mono Transaction Metadata API and Supabase, with automated sync triggered on user login',
    ],
  },
  {
    role: 'Backend Engineer(Lead)',
    org: 'pitchers international',
    period: '2026',
    points: [
      'Led the redesign of a 10,000+ line Node.js/MongoDB codebase into a cleaner, modular structure with REST API layers',
      'Implemented and maintained Paystack webhook handlers for payment event processing, ensuring reliable idempotent updates to transaction rescords',
      'Mentored 2 backend developers, reviewed code and owned core business logic to maintain consistency across the codebase.',
      'Authored backend developer documentation and introduced engineering practices that improved maintainability and security posture.'

    ]
  }, 
   {
    role: 'Backend Engineer',
    org: 'VocIntervue',
    period: '2026',
    points: [
      'Integrated the Deepgram speech-to-text API to power real-time voice interviews, enabling accurate transcription for downstream AI evaluation',
      'Structured and processed the interview transcript data for consumption by the platform AI feedback and scoring pipeline.',
      'Built the subscription and entitlement system end-to-end in 2 weeks using NestJs and PostgreSQL and integrated it accros core application modules',
      'Co-designed backend architecture with the founding team, shaping data models and service boundaries',
      'Set up backend infrastructure supporting the system launch'
    ]
  }
];

const certifications = [
  { name: 'Altschool Africa', detail: 'Backend Developer Diploma' },
  { name: 'FlyRank AI', detail: 'Backend AI Engineering Internship' },
  { name: 'Anthropic AI certifications', detail: 'AI courses completed' },
];
---

<Layout title="Projects — Gordian Okon">
  <Nav />

  <section class="mx-auto max-w-5xl px-4 pt-16 text-center lg:px-6">
    <span class="eyebrow">Portfolio</span>
    <h1 class="mt-2 font-display text-4xl font-bold">
      Projects &amp; experience
    </h1>
  </section>

  <Project />

  <section class="mx-auto max-w-5xl px-4 py-16 lg:px-6">
    <span class="eyebrow">Track record</span>
    <h2 class="mt-2 font-display text-3xl font-bold">Experience</h2>

    <div class="mt-8 grid gap-5 sm:grid-cols-2">
      {
        experience.map((job) => (
          <div class="overflow-hidden rounded-2xl border border-ink-600 bg-ink-900">
            <div class="p-5">
              <h3 class="font-display text-lg font-semibold">{job.org}</h3>
              <p class="eyebrow mt-1 text-gold-400">{job.role}</p>
              <ul class="mt-3 space-y-1.5 text-sm text-paper-300">
                {job.points.map((point) => (
                  <li class="flex gap-2">
                    <span class="text-gold-400">›</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16 lg:px-6">
    <span class="eyebrow">Credentials</span>
    <h2 class="mt-2 font-display text-3xl font-bold">Certifications</h2>

    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      {
        certifications.map((cert) => (
          <div class="rounded-xl border border-ink-600 bg-ink-900 p-4 text-center">
            <p class="font-display font-semibold">{cert.name}</p>
            <p class="mt-1 text-sm text-paper-500">{cert.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <Footer />
</Layout>
