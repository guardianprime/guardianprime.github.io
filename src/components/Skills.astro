---
import fastApi from '../assets/icons-vectors/fastapi.svg?url';
import nodejs from '../assets/icons-vectors/nodejs.svg?url';
import graphql from '../assets/icons-vectors/graphql.svg?url';
import postgresql from '../assets/icons-vectors/postgresql.svg?url';
import mongodb from '../assets/icons-vectors/mongodb.svg?url';
import javascript from '../assets/icons-vectors/javascript.svg?url';
import reactjs from '../assets/icons-vectors/reactjs.svg?url';
import nextjs from '../assets/icons-vectors/nextjs.svg?url';
import typescript from '../assets/icons-vectors/typescript.svg?url';
import tailwind from '../assets/icons-vectors/tailwindcss.svg?url';
import mysql from '../assets/icons-vectors/mysql.svg?url';

const groups = [
  {
    title: 'Backend engineering',
    copy: 'APIs, schemas, and data pipelines — this is the core of what I do. Built REST endpoints and Postgres/MongoDB data models for NombaLens; comfortable with query design past basic CRUD.',
    icons: [
      { src: nodejs, label: 'Node.js' },
      { src: postgresql, label: 'PostgreSQL' },
      { src: mongodb, label: 'MongoDB' },
      { src: mysql, label: 'MySQL' },
    ],
  },
  {
    title: 'AI / LLM integration',
    copy: 'RAG retrieval pipelines with vector stores and LLM API integration (OpenAI, Claude) into production Node.js services — day-to-day work at Flyrank.',
    icons: [
      { src: fastApi, label: 'FastAPI' },
      { src: javascript, label: 'JavaScript' },
      { src: graphql, label: 'GraphQL' },
    ],
  },
  {
    title: 'Full-stack delivery',
    copy: 'Can take a feature from API to a working UI when a project needs it — Next.js dashboards, typed end to end.',
    icons: [
      { src: reactjs, label: 'React' },
      { src: nextjs, label: 'Next.js' },
      { src: typescript, label: 'TypeScript' },
      { src: tailwind, label: 'Tailwind CSS' },
    ],
  },
];
---

<section id="skills" class="mx-auto max-w-5xl px-4 py-16 lg:px-6">
  <span class="eyebrow">Skills</span>
  <h2 class="mt-2 font-display text-3xl font-bold">Where I focus</h2>

  <div class="mt-8 grid gap-5 lg:grid-cols-3">
    {
      groups.map((group) => (
        <div class="flex flex-col rounded-2xl border border-ink-600 bg-ink-900 p-5">
          <h3 class="font-display text-lg font-semibold">{group.title}</h3>
          <p class="mt-2 text-sm text-paper-300">{group.copy}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {group.icons.map((icon) => (
              <div
                class="flex h-10 w-10 items-center justify-center rounded-lg border border-ink-600 bg-ink-800 p-2"
                title={icon.label}
              >
                <img src={icon.src} alt={icon.label} class="h-full w-full object-contain" />
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
