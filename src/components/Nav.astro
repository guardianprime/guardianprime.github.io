---
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full py-4 px-4">
  <nav
    class="mx-auto flex max-w-3xl justify-center md:items-center md:justify-between lg:justify-around rounded-full border border-ink-600/70 bg-ink-900/80 px-3 py-2 backdrop-blur-md sm:px-5"
  >
    <a
      href="/"
      class="font-display text-sm font-semibold tracking-tight text-paper-100 no-underline hidden md:block"
    >
      GUARDIANPRIME
    </a>
    <ul class="flex items-center gap-1 sm:gap-2">
      {
        links.map((link) => {
          const active =
            path === link.href ||
            (link.href !== '/' && path.startsWith(link.href));
          return (
            <li>
              <a
                href={link.href}
                class:list={[
                  'rounded-full px-3 py-1.5 text-xs font-medium no-underline transition-colors sm:text-sm',
                  active
                    ? 'bg-gold-400 text-ink-950'
                    : 'text-paper-300 hover:text-paper-100',
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>
