---
import Placeholder from '../assets/placeholder.png?url';
---

<section id="projects" class="h-300 p-4 mt-5">
  <h1 class="text-5xl uppercase text-center">Recent Projects</h1>

  <div
    class="grid w-[min(calc(100%-4rem),1520px)] mx-auto my-8 gap-4 grid-cols-1 auto-rows-[200px]
            min-[400px]:grid-cols-2
            min-[600px]:grid-cols-6
            min-[800px]:grid-cols-4"
  >
    <!-- PROJECT 1 -->
    <a
      href="#"
      class="group relative block overflow-hidden rounded-[10px] text-black no-underline
              after:content-[''] after:absolute after:inset-0 after:bg-gradient-to-b after:from-black/25 after:to-transparent after:to-[25%]
              row-start-2 row-span-1
              min-[400px]:row-start-3 min-[400px]:row-span-2 min-[400px]:col-span-2
              min-[600px]:row-start-3 min-[600px]:row-span-2 min-[600px]:col-start-1 min-[600px]:col-span-4
              min-[800px]:row-start-1 min-[800px]:row-span-1 min-[800px]:col-start-1 min-[800px]:col-span-1"
    >
      <p
        class="absolute z-[2] top-3 left-auto right-3 text-[0.9rem] text-right text-wrap-balance"
      >
        PROJECT 1
      </p>
      <img
        src={Placeholder}
        class="w-full h-full max-w-full block object-cover rounded-[10px] transition-transform duration-1000 ease-in-out group-hover:scale-[1.2] group-hover:rotate-[4deg]"
      />
    </a>

