---
import trackly from '../assets/project-images/trackly.png?url';
import sabiguy from '../assets/project-images/sabiguy.png?url';
import abygadgets from '../assets/project-images/abygadgets.png?url';
import Placeholder from '../assets/placeholder.png?url';

const projects = [
  {
    name: 'NombaLens',
    tag: 'Fintech',
    blurb:
      'Merchant dashboard and browser extension built on top of the NombaLens API.',
    image: Placeholder,
  },
  {
    name: 'Trackly',
    tag: 'Web app',
    blurb:
      'Habit and progress tracking app focused on a fast, distraction-free daily flow.',
    image: trackly,
  },
  {
    name: 'Aby-Gadgets',
    tag: 'E-commerce',
    blurb: 'Storefront and checkout experience for a gadgets retailer.',
    image: abygadgets,
  },
  {
    name: 'Prodoc',
    tag: 'SaaS',
    blurb: 'Document workflow tool for teams handling client paperwork.',
    image: trackly,
  },
  {
    name: 'Sabi Guy',
    tag: 'CMS',
    blurb:
      'Content-managed site for a local church community, built for easy self-editing.',
    image: sabiguy,
  },
  {
    name: 'Real Estate Manager',
    tag: 'Platform',
    blurb: 'Listings and management dashboard for a real estate business.',
    image: trackly,
  },
];
---

<section id="projects" class="mx-auto max-w-5xl px-4 py-16 lg:px-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <span class="eyebrow">Field work</span>
      <h2 class="mt-2 font-display text-3xl font-bold">Recent projects</h2>
    </div>
    <a
      href="/projects"
      class="rounded-full border border-ink-600 px-4 py-2 text-sm font-medium text-paper-100 no-underline transition-colors hover:border-gold-400 hover:text-gold-400"
    >
      See all projects →
    </a>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <a
          href="/projects"
          class="group block overflow-hidden rounded-2xl border border-ink-600 bg-ink-900 no-underline transition-colors hover:border-gold-400"
        >
          <div class="relative overflow-hidden">
            <img
              src={project.image}
              alt=""
              class="h-40 w-full object-fit transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <span class="eyebrow absolute left-3 top-3 rounded-full bg-ink-950/80 px-2 py-1 text-gold-400">
              {project.tag}
            </span>
          </div>
          <div class="p-4">
            <h3 class="font-display text-lg font-semibold text-paper-100">
              {project.name}
            </h3>
            <p class="mt-1 text-sm text-paper-300">{project.blurb}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
