---
import trackly from '../assets/project-images/trackly.png?url';
import sabiguy from '../assets/project-images/sabiguy.png?url';
import abygadgets from '../assets/project-images/abygadgets.png?url';
import nombalens from '../assets/project-images/nombalens.png?url';
import Placeholder from '../assets/placeholder.png?url';

// href: internal case-study page when one exists, otherwise the GitHub
// repo directly — never a link that just re-shows this same list.
const projects = [
  {
    name: 'NombaLens',
    tag: 'Fintech',
    blurb:
      'Merchant analytics layer on the Nomba Checkout API — payment-method ranking, split-payment configurator, and a real-time conversion dashboard.',
    image: nombalens,
    href: '/projects/nombalens',
  },
  {
    name: 'Trackly',
    tag: 'Fintech',
    blurb:
      'Financial taxonomy system with an automated transaction-rules engine and a Mono API \u2192 Supabase sync pipeline, triggered on user login.',
    image: trackly,
    href: 'https://github.com/guardianprime',
  },
  {
    name: 'Aby-Gadgets',
    tag: 'E-commerce',
    blurb:
      'Fullstack storefront and checkout — REST APIs for auth, product management, and order workflows.',
    image: abygadgets,
    href: 'https://github.com/guardianprime/aby-gadgets-ecommerce',
  },
  {
    name: 'Fullstack URL Shortener',
    tag: 'Systems',
    blurb:
      'URL shortener with redirect tracking and analytics endpoints, built with Node.js, Express, and MongoDB.',
    image: Placeholder,
    href: 'https://github.com/guardianprime/url-shortener',
  },
  {
    name: 'Prodoc',
    tag: 'SaaS',
    blurb:
      'Backend that extracts and structures data from invoices and receipts using OCR and NLP.',
    image: trackly,
    href: 'https://github.com/guardianprime/prodoc',
  },
  {
    name: 'Towello',
    tag: 'Hackathon',
    blurb:
      'Bayse Africa Hackathon project — backend architecture and API development for a rapidly prototyped product.',
    image: Placeholder,
    href: 'https://github.com/guardianprime',
  },
  {
    name: 'Sabi Guy',
    tag: 'Web app',
    blurb:
      'Logistics and dispatch platform helping individuals and businesses move items quickly within Ibadan and its environs.',
    image: sabiguy,
    href: 'https://github.com/guardianprime',
  },
  {
    name: 'Real Estate Manager',
    tag: 'Platform',
    blurb: 'Listings and management dashboard for a real estate business.',
    image: trackly,
    href: 'https://github.com/guardianprime',
  },
];
---

<section id="projects" class="mx-auto max-w-5xl px-4 py-16 lg:px-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <span class="eyebrow">Projects</span>
      <h2 class="mt-2 font-display text-3xl font-bold">Recent projects</h2>
    </div>
    <a
      href="/projects"
      class="rounded-full border border-ink-600 px-4 py-2 text-sm font-medium text-paper-100 no-underline transition-colors hover:border-gold-400 hover:text-gold-400"
    >
      See all projects →
    </a>
  </div>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project) => (
        <a
          href={project.href}
          class="group block overflow-hidden rounded-2xl border border-ink-600 bg-ink-900 no-underline transition-colors hover:border-gold-400"
        >
          <div class="relative overflow-hidden">
            <img
              src={project.image}
              alt={`${project.name} — ${project.tag} project screenshot`}
              class="h-40 w-full object-fit transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <span class="eyebrow absolute left-3 top-3 rounded-full bg-ink-950/80 px-2 py-1 text-gold-400">
              {project.tag}
            </span>
          </div>
          <div class="p-4">
            <h3 class="font-display text-lg font-semibold text-paper-100">
              {project.name}
            </h3>
            <p class="mt-1 text-sm text-paper-300">{project.blurb}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>
