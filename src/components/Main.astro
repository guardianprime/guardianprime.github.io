---
import IDCard from './IDCardNew.astro';

const stats = [
  { value: '+1', label: 'years of experience' },
  { value: '+10', label: 'projects shipped' },
  { value: '+3', label: 'clients' },
];
---

<main
  class="mx-auto flex max-w-5xl flex-col items-center gap-10 px-4 lg:flex-row lg:items-center lg:justify-between lg:gap-6 lg:px-6"
>
  <IDCard />

  <div
    class="flex flex-col items-center text-center lg:w-3/5 lg:items-start lg:text-left"
  >
    <span class="eyebrow">Access badge · Software Engineer</span>
    <h1
      class="mt-3 font-display text-4xl font-bold uppercase leading-tight tracking-tight sm:text-5xl"
    >
      Gordian Okon
    </h1>
    <p class="mt-4 max-w-md text-paper-300">
      Backend-leaning engineer who builds APIs, web products, and AI-powered
      tools — and enjoys turning rough ideas into interfaces people actually
      want to use.
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-3 lg:justify-start">
      <a
        href="/projects"
        class="rounded-full bg-gold-400 px-5 py-2.5 text-sm font-semibold text-ink-950 no-underline transition-transform hover:-translate-y-0.5"
      >
        View projects
      </a>
      <a
        href="/contact"
        class="rounded-full border border-ink-600 px-5 py-2.5 text-sm font-semibold text-paper-100 no-underline transition-colors hover:border-gold-400 hover:text-gold-400"
      >
        Say hi
      </a>
    </div>

    <div class="stub-divider mt-8 w-full"></div>

    <div class="mt-8 flex w-full justify-center gap-8 lg:justify-start">
      {
        stats.map((stat) => (
          <div class="text-center lg:text-left">
            <span class="font-display text-3xl font-bold text-gold-400">
              {stat.value}
            </span>
            <p class="eyebrow mt-1 text-paper-500">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</main>
