---
import Github from '../assets/icons-vectors/github.svg?url';
import Linkedin from '../assets/icons-vectors/linkedin.svg?url';
import Twitter from '../assets/icons-vectors/twitter.svg?url';

const EMAIL = 'okongordian@gmail.com';

const socials = [
  { name: 'Github', icon: Github, href: 'https://github.com/guardianprime' },
  { name: 'LinkedIn', icon: Linkedin, href: 'https://www.linkedin.com/in/gordian-okon-7b73382b9' },
  { name: 'Twitter', icon: Twitter, href: 'https://x.com/GordianOkon' },
];
---

<section id="contact" class="mx-auto max-w-3xl px-4 py-16 text-center lg:px-6">
  <span class="eyebrow">Get in touch</span>
  <h2 class="mt-2 font-display text-4xl font-bold uppercase">Let's work together</h2>
  <p class="mx-auto mt-4 max-w-xl text-paper-300">
    Looking for a developer to join your team or build your next product? I'm
    currently open to new opportunities in backend and web development.
    Whether you have a project idea, a role to discuss, or just want to
    connect — let's talk.
  </p>

  <div class="mx-auto mt-6 flex max-w-sm flex-col justify-center gap-3 sm:flex-row">
    <a
      href={`mailto:${EMAIL}`}
      class="rounded-full bg-gold-400 px-6 py-3 text-sm font-semibold text-ink-950 no-underline transition-transform hover:-translate-y-0.5"
    >
      Say hi
    </a>
    <a
      href={`mailto:${EMAIL}?subject=Let's%20book%20a%20call`}
      class="rounded-full border border-ink-600 px-6 py-3 text-sm font-semibold text-paper-100 no-underline transition-colors hover:border-gold-400 hover:text-gold-400"
    >
      Book a call
    </a>
  </div>

  <div class="stub-divider mx-auto mt-10 max-w-xs"></div>
  <p class="eyebrow mt-6">or find me on</p>

  <div class="mx-auto mt-4 flex max-w-xs justify-center gap-8">
    {
      socials.map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex flex-col items-center gap-2 text-paper-300 no-underline transition-colors hover:text-gold-400"
        >
          <img src={social.icon} alt="" class="h-8 w-8" />
          <span class="text-xs">{social.name}</span>
        </a>
      ))
    }
  </div>
</section>
